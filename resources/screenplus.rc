#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"
IDR_DEPTH_HTML RCDATA "depth.html"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "screenplus.manifest"

#ifndef SP_VERSION_STR                 /* normally defined by CMake from the project version */
#define SP_VERSION_STR "1.0.0"
#define SP_VER_MAJOR 1
#define SP_VER_MINOR 0
#define SP_VER_PATCH 0
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SP_VER_MAJOR,SP_VER_MINOR,SP_VER_PATCH,0
 PRODUCTVERSION SP_VER_MAJOR,SP_VER_MINOR,SP_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Screen+"
            VALUE "FileDescription", "Screen+ wallpaper engine"
            VALUE "FileVersion", SP_VERSION_STR
            VALUE "InternalName", "ScreenPlus"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "ScreenPlus.exe"
            VALUE "ProductName", "Screen+"
            VALUE "ProductVersion", SP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
