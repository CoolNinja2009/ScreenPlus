# sample_apps.cmake: the Windows build's sample wallpapers are the Bare programs, not the pages.
#   cmake -DBUILD=<build> -DSAMPLES=<build>/samples -DVERSION=<x.y.z> -DHEADER=src/common/sample_apps.h -P sample_apps.cmake
# Runs after every build (target sample-apps, src/ui_bare/CMakeLists.txt), once ScreenPlus copied samples\ from the
# source tree and every sample program was packed into <build>/<name>.spf. Rows come from sample_apps.h's table.
#  - samples\<html> (the page) goes; samples\<name> is the .spf's media/wallpaper unpacked, with a LivelyInfo.json
#    (Type 0: an app) so the library names it and shows its preview. Setup, the portable zip and the Store package
#    all take samples\ as it is here, so each build ships the programs it just made.
#  - ScreenPlus-<version>-samples.zip (setup's optional download, the app's sample updates) is remade from the
#    programs besides setup's own three, with samples.json (every file's SHA-256), sizes.nsh and samples_pin.h
#    (its size, SHA-256 and id for ScreenPlus.com) beside it. The configure step's page zip is replaced.
cmake_minimum_required(VERSION 3.20)
foreach(v BUILD SAMPLES VERSION HEADER)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "sample_apps: ${v} is not set")
    endif()
endforeach()
set(_work "${BUILD}/sample-apps")
file(MAKE_DIRECTORY "${_work}" "${SAMPLES}")
file(READ "${HEADER}" _h)
string(REGEX MATCHALL "\\{ L\"[^\"]+\", +L\"[^\"]+\", +L\"[^\"]+\", +L\"[^\"]+\"" _rows "${_h}")
list(LENGTH _rows _n)
if(_n LESS 1)
    message(FATAL_ERROR "sample_apps: no rows in ${HEADER}")
endif()
set(_bundled Aurora Singularity KoiPond)   # setup carries these; the zip has the rest
set(_zipped "")
set(_sig "")
foreach(_row IN LISTS _rows)
    string(REGEX MATCH "\\{ L\"([^\"]+)\", +L\"([^\"]+)\", +L\"([^\"]+)\", +L\"([^\"]+)\"" _m "${_row}")
    set(_name "${CMAKE_MATCH_1}")
    set(_exe "${CMAKE_MATCH_2}")
    set(_html "${CMAKE_MATCH_3}")
    set(_title "${CMAKE_MATCH_4}")
    set(_spf "${BUILD}/${_name}.spf")
    if(NOT EXISTS "${_spf}")
        message(FATAL_ERROR "sample_apps: ${_spf} is missing (configure with -DSCREENPLUS_BARE_UI=ON)")
    endif()
    file(SHA256 "${_spf}" _spf_sha)
    string(APPEND _sig "${_name} ${_spf_sha}\n")
    if(NOT _html STREQUAL _name)
        file(REMOVE_RECURSE "${SAMPLES}/${_html}")
    endif()
    set(_stamp "${_work}/${_name}.unpacked")
    set(_had "")
    if(EXISTS "${_stamp}")
        file(READ "${_stamp}" _had)
    endif()
    if(NOT _had STREQUAL _spf_sha OR NOT EXISTS "${SAMPLES}/${_name}/${_exe}" OR EXISTS "${SAMPLES}/${_name}/index.html")
        set(_tmp "${_work}/x-${_name}")
        file(REMOVE_RECURSE "${_tmp}" "${SAMPLES}/${_name}")
        file(ARCHIVE_EXTRACT INPUT "${_spf}" DESTINATION "${_tmp}" PATTERNS "media/wallpaper/*")
        if(NOT EXISTS "${_tmp}/media/wallpaper/${_exe}")
            message(FATAL_ERROR "sample_apps: ${_spf} holds no media/wallpaper/${_exe}")
        endif()
        file(RENAME "${_tmp}/media/wallpaper" "${SAMPLES}/${_name}")
        file(REMOVE_RECURSE "${_tmp}")
        file(WRITE "${SAMPLES}/${_name}/LivelyInfo.json"
            "{\"AppVersion\":\"1.0.0.0\",\"Title\":\"${_title}\",\"Thumbnail\":\"preview.jpg\",\"Preview\":\"preview.jpg\","
            "\"Desc\":\"\",\"Author\":\"Screen+\",\"License\":\"LICENSE.txt\",\"Contact\":\"\",\"Type\":0,"
            "\"FileName\":\"${_exe}\",\"Arguments\":\"\",\"IsAbsolutePath\":false}\n")
        file(WRITE "${_stamp}" "${_spf_sha}")
    endif()
    if(NOT _name IN_LIST _bundled)
        list(APPEND _zipped "${_name}")
    endif()
endforeach()

# Setup and the Store package take samples as they are: stage.sig changes only when a program does (setup's DEPENDS).
set(_had "")
if(EXISTS "${_work}/stage.sig")
    file(READ "${_work}/stage.sig" _had)
endif()
if(NOT _had STREQUAL _sig)
    file(WRITE "${_work}/stage.sig" "${_sig}")
endif()

# The download: remade when a program changed, or when the configure step put its page zip in its place.
set(_zip "${BUILD}/ScreenPlus-${VERSION}-samples.zip")
set(_zip_stamp "${_work}/zip.sig")
set(_had "")
if(EXISTS "${_zip_stamp}")
    file(READ "${_zip_stamp}" _had)
endif()
set(_zip_sha "")
if(EXISTS "${_zip}")
    file(SHA256 "${_zip}" _zip_sha)
endif()
if(NOT _had STREQUAL "${_sig}${_zip_sha}")
    file(REMOVE "${_zip}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${_zip}" --format=zip "--mtime=2000-01-01 00:00:00 UTC" -- ${_zipped}
                    WORKING_DIRECTORY "${SAMPLES}" RESULT_VARIABLE _rc)
    if(_rc)
        message(FATAL_ERROR "sample_apps: could not pack ${_zip}")
    endif()
    file(SHA256 "${_zip}" _zip_sha)
    file(WRITE "${_zip_stamp}" "${_sig}${_zip_sha}")
endif()
file(SIZE "${_zip}" _zip_size)

# samples.json and the id: every file of the zipped programs (the same content gives the same id, build to build).
set(_unpacked 0)
set(_ids "")
set(_manifest "")
foreach(_name IN LISTS _zipped)
    file(GLOB_RECURSE _files RELATIVE "${SAMPLES}" "${SAMPLES}/${_name}/*")
    list(SORT _files)
    foreach(_r IN LISTS _files)
        file(SIZE "${SAMPLES}/${_r}" _s)
        math(EXPR _unpacked "${_unpacked} + ${_s}")
        file(SHA256 "${SAMPLES}/${_r}" _sha)
        string(APPEND _ids "${_r} ${_sha}\n")
        string(APPEND _manifest ",\n\"${_r}\":\"${_sha}\"")
    endforeach()
endforeach()
string(SHA256 _id "${_ids}")
string(SUBSTRING "${_manifest}" 1 -1 _manifest)
file(WRITE "${BUILD}/ScreenPlus-${VERSION}-samples.json" "{\"id\":\"${_id}\",\"files\":{${_manifest}\n}}\n")
math(EXPR _kb "${_unpacked} / 1024")
math(EXPR _mb "(${_zip_size} + 524288) / 1048576")
file(WRITE "${BUILD}/sizes.nsh" "!define SAMPLES_KB ${_kb}\n!define SAMPLES_DL_MB ${_mb}\n!define SAMPLES_ID ${_id}\n")
set(_pin "/* cmake/sample_apps.cmake: the sample programs' zip, as built */\n#undef SP_SAMPLES_SIZE\n#undef SP_SAMPLES_SHA256\n#undef SP_SAMPLES_ID\n#define SP_SAMPLES_SIZE ${_zip_size}\n#define SP_SAMPLES_SHA256 \"${_zip_sha}\"\n#define SP_SAMPLES_ID \"${_id}\"\n")
set(_old_pin "")
if(EXISTS "${BUILD}/samples_pin.h")
    file(READ "${BUILD}/samples_pin.h" _old_pin)
endif()
if(NOT _old_pin STREQUAL _pin)   # unchanged: ScreenPlus.com isn't rebuilt
    file(WRITE "${BUILD}/samples_pin.h" "${_pin}")
endif()
list(LENGTH _zipped _nz)
message(STATUS "sample_apps: ${_n} programs in samples, ${_nz} in ScreenPlus-${VERSION}-samples.zip (${_mb} MB)")
