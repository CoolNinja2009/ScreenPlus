# UI languages: packs resources/lang/<code>.txt into ${CMAKE_BINARY_DIR}/lang_data.c (sp_langs, read by
# src/common/i18n.c). Runs at configure time and again whenever a language file changes.
file(GLOB SP_LANG_FILES CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/resources/lang/*.txt")
list(SORT SP_LANG_FILES)
set(_lang_c "/* Generated by cmake/lang.cmake from resources/lang. */\n#include <stddef.h>\n")
set(_lang_t "")
foreach(f IN LISTS SP_LANG_FILES)
    get_filename_component(code "${f}" NAME_WE)
    string(MAKE_C_IDENTIFIER "${code}" id)
    file(READ "${f}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND _lang_c "static const unsigned char l_${id}[] = {${hex}0};\n")
    string(APPEND _lang_t "    {\"${code}\", (const char *)l_${id}},\n")
endforeach()
string(APPEND _lang_c "struct SpLangData { const char *code; const char *text; };\n"
                      "const struct SpLangData sp_langs[] = {\n${_lang_t}    {NULL, NULL}\n};\n")
set(SP_LANG_C "${CMAKE_BINARY_DIR}/lang_data.c")
file(CONFIGURE OUTPUT "${SP_LANG_C}" CONTENT "${_lang_c}" @ONLY)
